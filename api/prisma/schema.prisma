generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Equipment {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String   // e.g., "Weapon", "Armor", "Talisman"
  description String?
  scaling     String?  // e.g., "Str B, Dex C"
  weight      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}